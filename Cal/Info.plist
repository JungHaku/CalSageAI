<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Breathwork keeps playing while the screen locks, so the user can put the
	  phone down and follow the audio (ARCHITECTURE.md §2). Needs the plist key
	  only — no entitlement, no capability.

	  "remote-notification" was the template default and is not used: the morning
	  check-in reminder is a local notification.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!--
	  Export compliance. The app uses only HTTPS and system-provided crypto, with
	  nothing proprietary, so it is exempt from export documentation. Declaring it
	  here means App Store Connect stops asking on every single upload — otherwise
	  every build sits at "Missing Compliance" until someone answers by hand.

	  Note Apple's own wording is that OS-provided encryption is *typically*
	  exempt. If anything custom is ever added, this answer has to be revisited.
	  Separately and easy to forget: the BIS annual self-classification report is
	  due 1 February and is a US government filing, not an Apple one
	  (docs/APP-STORE.md §5).
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  Portrait only. The breathwork screen is a single large ring the user paces
	  against, often with the phone propped up or face down; landscape gives it
	  ~400pt of height and squeezes the whole exercise off screen. Locking here
	  rather than defensively re-laying-out every screen for a case the product
	  doesn't want.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!--
	  Calendar (Planner tab).

	  This MUST be NSCalendarsFullAccessUsageDescription (iOS 17+), not the older
	  NSCalendarsUsageDescription. Apple: on iOS 17 or later, an app that includes
	  only the old key has any access request AUTOMATICALLY DENIED — no prompt, no
	  error, no crash. It simply never works, which is very hard to diagnose.

	  Full access is requested because Apple provides no read-only calendar tier:
	  "To read events or reminders from the event store, your app needs full
	  access." C.A.L only ever reads. The write-only key is deliberately absent —
	  requesting a permission the app doesn't use invites 5.1.1(iii) data
	  minimisation questions at review.
	-->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>C.A.L shows today's classes and deadlines from the calendars already on your phone. It only reads them and never adds, edits, or deletes anything.</string>

	<!--
	  Microphone (voice-first root). Required before any AVAudioSession /
	  ElevenLabs session opens — without it the app crashes on first talk.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>C.A.L listens so you can talk to him out loud. You can type instead anytime.</string>

	<!--
	  Camera. C.A.L does not use the camera, but LiveKit (pulled in by the
	  ElevenLabs voice SDK) links camera APIs. App Store Connect rejects the
	  binary without this purpose string even when the feature is unused.
	-->
	<key>NSCameraUsageDescription</key>
	<string>C.A.L does not use your camera. This permission is only declared because a voice library includes camera support.</string>

	<!--
	  LiveKit (ElevenLabs voice) uses Bonjour/mDNS while gathering ICE candidates.
	  Without these keys iOS silently denies local-network access and the WebRTC
	  room drops immediately — which is the "connection dropped" TestFlight saw.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>C.A.L uses the local network so a live voice session can connect.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_livekit._tcp</string>
		<string>_livekit._udp</string>
	</array>
	<key>CalSupabaseURL</key>
	<string>https://woudmxksrkrzjnmlfven.supabase.co</string>
	<key>CalSupabaseAnonKey</key>
	<string>sb_publishable_YjybSnfDgUvhTHCmBNFEDQ_0yb3N0cd</string>
	<key>CalSupportEmail</key>
	<string>beck.alexmlg@gmail.com</string>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
